# ---------------------------------------------------------------------------
# Conexión a Supabase PostgreSQL
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Usa el "Session pooler" (puerto 5432) para soportar transacciones y
# SELECT ... FOR UPDATE. Ejemplo:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/afirmative_pill
# true para Supabase (TLS obligatorio); false para Postgres local
DATABASE_SSL=false

PORT=4000
# Orígenes permitidos por CORS para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Latencia artificial del proyector (ms) para hacer visible la consistencia eventual
PROJECTION_DELAY_MS=800
# Tiempo que tarda el "químico farmacéutico" automático en validar la orden (ms)
APPROVAL_DELAY_MS=4000
# true: el process manager aprueba/rechaza automáticamente las órdenes.
# false: la aprobación se hace manualmente desde /admin (mutation approveOrder)
AUTO_APPROVAL=true

# Logs de cada consulta SQL y de cada lote de DataLoader (evidencia N+1)
LOG_SQL=true
LOG_DATALOADER=true
